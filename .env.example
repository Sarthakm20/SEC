# Copy to .env and fill in. .env is git-ignored.

# --- Required: SEC fair-access policy requires a descriptive User-Agent with a contact email ---
SEC_USER_AGENT=YourAppName you@example.com

# --- Optional: LLM for answer prose. Everything works without one, at no cost. ---
# offline : deterministic answers from verified evidence (free, default recommendation)
# gemini  : free tier via a Google AI Studio key (default model: gemini-3.8-flash)
# ollama  : free local model (needs a decent CPU/GPU and >= 16 GB RAM to be usable)
# anthropic / openai : paid APIs
LLM_PROVIDER=offline           # offline | gemini | ollama | anthropic | openai | auto
# GEMINI_API_KEY=              # ONE free key from https://aistudio.google.com/ (limits are per project, so extra keys add nothing)
# LLM_MODEL=gemini-3.5-flash-lite  # free-tier quotas are PER MODEL: 3.5-flash allowed only ~20 requests/day on our
#                              # key, 3.5-flash-lite handled a full 108-question benchmark. Check: python -m app.cli test-llm.
#                              # Older models (e.g. 2.5-flash)
#                              # return 404 "no longer available to new users"; a 503 means "high demand, retry later"
# LLM_MIN_INTERVAL_SECONDS=6   # pacing between LLM calls; default 6 s for gemini (10 req/min) — match your model's RPM
# LLM_RATE_LIMIT_RETRIES=3     # per-minute 429s wait for Google's suggested delay; a used-up DAILY quota fails fast
# ANTHROPIC_API_KEY=           # paid; default model claude-opus-5-5
# OPENAI_API_KEY=              # paid
# LLM_EFFORT=medium            # Anthropic output_config.effort
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Retrieval (defaults are CPU-friendly; evaluate alternatives with the benchmark) ---
# EMBEDDING_PROVIDER=fastembed  # fastembed | openai | hash
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RERANKER_PROVIDER=fastembed   # fastembed | cohere | none
# RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2   # or BAAI/bge-reranker-base (~1 GB, slower, usually better)
# COHERE_API_KEY=
# RETRIEVAL_CANDIDATES=25
# RERANK_CANDIDATES=15
# RERANK_TOP_N=6

# --- Scope ---
# DEFAULT_TICKERS=["AAPL","MSFT","NVDA"]
# DEFAULT_FISCAL_YEARS=[2023,2024,2025]

# --- Storage (empty = local SQLite + embedded Qdrant under backend/data; docker-compose sets the servers) ---
# DATABASE_URL=postgresql+psycopg://secrag:secrag@localhost:5432/secrag
# QDRANT_URL=http://localhost:6333

# --- API security ---
# APP_API_KEY=                 # if set, clients must send X-API-Key
# RATE_LIMIT_PER_MINUTE=60
